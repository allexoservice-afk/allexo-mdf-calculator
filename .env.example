# Публічний сайт (кастомний домен)
# VITE_SITE_URL=https://allexo.be

# Meta (Facebook) Pixel — опційно (за замовчуванням 981047808085366)
# VITE_META_PIXEL_ID=981047808085366

# Supabase → Settings → API (потрібні на етапі BUILD у Cloudflare Pages, не лише Functions!)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# --- Листи після заявки: варіант A (Resend) ---
# Секрети НЕ в .env — лише в Cloudflare Pages → Settings → Environment variables:
#   RESEND_API_KEY      (Encrypt) — https://resend.com/api-keys
#   RESEND_FROM_EMAIL   — ALLEXO <info@allexo.be> (після верифікації домену в Resend)
#   OWNER_EMAIL         — info@allexo.be
#   ALLOWED_ORIGINS     — https://allexo.be,https://www.allexo.be
# Локально: скопіюйте .dev.vars.example → .dev.vars і запустіть pnpm dev:api + pnpm dev
#
# Деплой: pnpm run deploy:pages
# Додати ключ у Cloudflare: pnpm run secret:resend

# Опційно (інший домен API): VITE_PROPOSAL_DELIVERY_URL=https://example.com/api/proposal-delivery

# Опційно EmailJS (лише якщо VITE_USE_EMAILJS=true)
# VITE_USE_EMAILJS=true
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_CLIENT_ID=
# VITE_EMAILJS_TEMPLATE_OWNER_ID=
# VITE_EMAILJS_PUBLIC_KEY=
